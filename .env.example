# Local CLI/worker works without these. Public Vercel deployments require sign-in.
QUANTA_AUTH__REQUIRED=true
QUANTA_AUTH__PUBLIC_URL=https://your-project.vercel.app
QUANTA_AUTH__GITHUB_CLIENT_ID=
QUANTA_AUTH__GITHUB_CLIENT_SECRET=
# Generate once: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
QUANTA_AUTH__ENCRYPTION_KEY=
# Neon FREE Postgres, pooled URL with sslmode=require. No SQLite on hosted scans.
QUANTA_CLOUD__ENABLED=true
QUANTA_CLOUD__DATABASE_URL=
# Created once from a tested Quanta commit by scripts/prepare_vercel.py.
QUANTA_CLOUD__SANDBOX_SNAPSHOT=
QUANTA_PRODUCT__SCANS_PER_USER_DAY=3
QUANTA_PRODUCT__SCANS_PER_MONTH=50
